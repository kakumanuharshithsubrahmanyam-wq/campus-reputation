# Frontend (Vite — all VITE_* values are embedded in the public bundle)
# Production: set to your deployed API origin (no trailing slash)
VITE_API_URL=http://localhost:4000

# Sepolia (must match backend CHAIN_ID)
VITE_CHAIN_ID=11155111

# Public site URL for QR codes and share links (production required)
# Example: https://campus-reputation.example.com
VITE_PUBLIC_APP_URL=
