# PostgreSQL (production: use managed DB connection string)
DATABASE_URL=postgresql://campus:campus@localhost:5432/campus_reputation

# Sepolia RPC (read-only; no private key)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# Deployed contracts (Sepolia — do not change without contract migration)
CAMP_TOKEN_ADDRESS=0xF2c2bC22de5df5e95F5bB27b65E53b569E83d918
BADGE_CONTRACT_ADDRESS=0x515677D8B9fe03998173032d7be9a0e7Ee78429c

# Auth — use a long random secret in production (min 16 chars)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
NONCE_TTL_MINUTES=10

# CORS: frontend origin(s). Comma-separated for multiple (e.g. prod + preview).
FRONTEND_ORIGIN=http://localhost:5173

PORT=4000

# Indexer: first block to scan (contract deploy block recommended for full history)
START_BLOCK=

CONFIRMATION_BLOCKS=3
INDEXER_BLOCK_CHUNK=1000

# Optional: run indexer inside API process (single instance only)
ENABLE_INDEXER_LOOP=false
INDEXER_INTERVAL_MS=60000
